        <before>false</before>
        <description/>
        <name>Script3</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[var patient=new GlideRecord('u_patient_record');
patient.addQuery("number","PAT0001027");
patient.query();
if(patient.next())
{
	var patientid = patient.getValue('sys_id');
	var med=new GlideRecord('u_medication');
	med.addQuery("u_patient_id",patientid);
	med.query();
	while(med.next())
	{
		gs.print("Medication ID:"+med.getDisplayValue('number')+"-------"+med.getValue('u_medication_name')+"------"+med.getValue('u_dosage'));
	}
}
else
{
	gs.print("No Medication for the patient.");
}

]]></script>
