        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var dosage = parseFloat(current.u_dosage);
    var frequencyText = current.u_frequency + ''; 

    var frequencyMap = {
        "Once Daily": 1,
        "Twice Daily": 2,
        "Thrice Daily": 3,
        "Four Times Daily": 4
    };

    var frequency = frequencyMap[frequencyText];

    if (!isNaN(dosage) && !isNaN(frequency)) {
        var total = dosage * frequency;

        
        current.u_total_dosage = Math.floor(total); 
    }

})(current, previous);
]]></script>
