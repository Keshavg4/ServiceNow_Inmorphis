        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    var billing = new BillingUtils();

    var total = billing.getTotalBillingAmount('681e5e68936a2610ec38b2ddfaba109e');
    gs.print('Total Billing Amount: ₹' + total.u_total_amount);


    var isOverdue = billing.isBillingOverdue('681e5e68936a2610ec38b2ddfaba109e');
    if (isOverdue) {
        gs.print('Bill is overdue')
    } else {
        gs.print('Bill is clear')
    }

    var billdetail = billing.getBillingByID('BLG0001033');
    if (billdetail) {
        gs.print("Total Amount: " + billdetail.u_total_amount);
        gs.print("Patient ID: " + billdetail.u_patient_id.getDisplayValue());
        gs.print("Status: " + billdetail.u_status);
    } else {
        gs.print("No billing record found.");
    }


    var bills = billing.getBillingByPatientID('681e5e68936a2610ec38b2ddfaba109e');

    while (bills.next()) {
        gs.print('₹' + bills.u_total_amount + ' | Billing ID: ' + bills.number);
    }


})(current, previous);]]></script>
