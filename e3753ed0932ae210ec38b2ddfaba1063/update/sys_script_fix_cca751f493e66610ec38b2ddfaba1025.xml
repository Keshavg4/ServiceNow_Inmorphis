        <before>false</before>
        <description/>
        <name>Script1</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[var patient = new GlideRecord('u_patient_record'); 
patient.addQuery('number', 'PAT0001083'); 
patient.query();

if (patient.next()) {
    var patientSysId = patient.getValue('sys_id');
    var appall = new GlideRecord('u_appointment'); 
    appall.addQuery('u_patient_id', patientSysId); 
    appall.query();

    while (appall.next()) {
        gs.print('Appointment Number: ' + appall.getValue('number'));
		gs.print(appall.getDisplayValue('u_doctor'));
		gs.print(appall.getValue('u_department'));
		gs.print(appall.getDisplayValue('u_appointment_date'));
		
    }

} else {
    gs.print('No patient found with ID: PAT0001083');
}
]]></script>
